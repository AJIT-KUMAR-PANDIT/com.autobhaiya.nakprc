# Auto Bhaiya by NAKPRC - Environment Variables Template
# Copy this file to .env or .env.local to configure Appwrite integration.

# Appwrite Cloud or Self-hosted Endpoint
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite Project ID (obtain from Appwrite Console -> Project Settings)
VITE_APPWRITE_PROJECT_ID=

# Appwrite Database ID
VITE_APPWRITE_DATABASE_ID=autobhaiya_db

# Appwrite Bookings Collection ID
VITE_APPWRITE_BOOKINGS_COLLECTION_ID=bookings

# Appwrite Autos Collection ID (Optional directory synchronization)
VITE_APPWRITE_AUTOS_COLLECTION_ID=autos
